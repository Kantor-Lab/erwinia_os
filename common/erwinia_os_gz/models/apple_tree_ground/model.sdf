<sdf version="1.7">
    <model name="apple_tree_ground">
        <static>true</static>
        <link name="ground">
            <visual name="ground">
                <geometry>
                    <mesh>
                        <uri>model://apple_tree_1/meshes/ground.obj</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.600 0.600 0.600 1</ambient>
                    <diffuse>1.000 1.000 1.000 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                    <emissive>0 0 0 1</emissive>
                    <pbr>
                        <metal>
                            <albedo_map>model://apple_tree_1/materials/dirt.jpg</albedo_map>
                            <roughness>0.7</roughness>
                            <metalness>0.0</metalness>
                        </metal>
                    </pbr>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>model://apple_tree_1/meshes/ground.obj</uri>
                    </mesh>
                </geometry>
                <surface>
                    <contact/>
                </surface>
            </collision>
        </link>
    </model>
</sdf>
