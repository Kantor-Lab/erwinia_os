<?xml version="1.0" encoding="utf-8"?>
<robot name="amiga_imu" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:macro name="amiga_imu" params="prefix:='' parent:='imu_mount' z_offset:='0.0'">

        <!-- IMU -->
        <link name="${prefix}imu_enu" />
        <joint name="${prefix}imu_joint" type="fixed">
            <origin xyz="0 0 ${z_offset}" rpy="0 0 0" />
            <parent link="${parent}" />
            <child link="${prefix}imu_enu" />
        </joint>

        <!-- TODO: Add gazebo impl later -->

    </xacro:macro>
</robot>
